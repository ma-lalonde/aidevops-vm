# Copy to .env and adjust. .env is gitignored; keep every account name and path there.

VM_NAME=aidevops-vm
POOL=default
VM_CPU=4
VM_MEMORY=8GiB
ROOT_SIZE=16GiB
# Block volume mounted on /home. up and rebuild never delete it.
HOME_SIZE=40GiB

# Node.js major from deb.nodesource.com (node_<major>.x). Check the current LTS before changing.
NODE_MAJOR=26

# Classic GitHub PAT (scopes repo, read:org, gist) of an account with Write, never admin, on the repos below.
# Left unset, the script asks for it on the terminal when the VM has no valid gh login; set, it names a file on
# this host, mode 0600, outside every repository, applied on every run.
#GITHUB_TOKEN_FILE=/path/to/github-token
GIT_USER_NAME="Example Bot"
GIT_USER_EMAIL="bot@example.com"

# on: the supervisor pulse runs on repos marked :pulse. off: it never runs.
PULSE=on
MAX_WORKERS=3
# Memory in MiB the pulse leaves free before admitting a worker.
RAM_RESERVE_MB=2048

# Unattended-upgrades restarts the VM at this time when an update needs it.
REBOOT_TIME=04:00

# Space-separated entries: owner/repo[:pulse][:base-branch]
#   owner/repo                  cloned and registered, pulse off (never init, never dispatch)
#   owner/repo:dev              pulse off, PRs target the branch dev
#   owner/repo:pulse            pulse on, PRs target the default branch
#   owner/repo:pulse:dev        pulse on, PRs target the branch dev
REPOS="example-owner/repo-a:pulse example-owner/repo-b:pulse:dev example-owner/repo-d:dev third-party/repo-c"

# Optional. A repository of rules for the workers: cloned to ~/Git/<owner>/<repo> when absent and fast-forwarded on
# every run. INSTRUCTIONS_FILES are space-separated paths inside it; each is added to `instructions` in
# ~/.config/opencode/opencode.json, so every OpenCode session loads it.
#INSTRUCTIONS_REPO=example-owner/rules
#INSTRUCTIONS_FILES="rules/core.md rules/project.md"

# Tools in the VM for the repos' gates. Go comes from Debian and fetches the toolchain a go.mod names.
# uv is installed at its latest release and updated daily by a timer in the VM.
# Vale: the release from github.com/errata-ai/vale, checked against the checksum the release publishes; stays pinned
# because a project's gate needs one exact version. Unset installs no Vale.
#VALE_VERSION=3.21.0
